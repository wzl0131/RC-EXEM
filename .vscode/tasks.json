{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "① 编译 (Build)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/build.ps1",
                "-Mode", "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "echo": false
            },
            "problemMatcher": []
        },
        {
            "label": "② 全部重新编译 (Rebuild)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/build.ps1",
                "-Mode", "rebuild"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "echo": false
            },
            "problemMatcher": []
        },
        {
            "label": "③ 编译并下载到板子 (Flash)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/build.ps1",
                "-Mode", "flash"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "echo": false
            },
            "problemMatcher": []
        },
        {
            "label": "④ 打开 Keil（改工程配置用）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Start-Process 'C:\\Keil_v5\\UV4\\UV4.exe' -ArgumentList '${workspaceFolder}\\MDK-ARM\\TEST.uvprojx'"
            ],
            "presentation": { "reveal": "silent" },
            "problemMatcher": []
        },
        {
            "label": "⑤ 打开 CubeMX（改硬件配置用）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Start-Process '${workspaceFolder}\\TEST.ioc'"
            ],
            "presentation": { "reveal": "silent" },
            "problemMatcher": []
        },
        {
            // ⭐ 用完 CubeMX 之后【第一件】必跑的事：给它去掉的 BOM 补回来
            //    CubeMX 把 .c/.h 存成不带 BOM 的 UTF-8 → Keil 里中文注释全乱码
            "label": "⑥ 补 BOM（CubeMX 生成后跑）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/fix_bom.ps1"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "echo": false
            },
            "problemMatcher": []
        },
        {
            // ⭐ 用完 CubeMX 重新生成代码之后，跑一下这个
            //    它会检查 6 个自写文件还在不在工程里，缺了自动补回去
            "label": "⑦ 检查工程文件（CubeMX 重新生成后跑）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/check_project.ps1",
                "-Fix"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "echo": false
            },
            "problemMatcher": []
        }
    ]
}
