{
    // ========================================================================
    //  调试配置 —— 需要装 Cortex-Debug 插件
    //  插件 ID: marus25.cortex-debug
    //
    //  ⚠️ 注意：这个调试器和 Keil 的调试【不能同时用】
    //     （都要独占 J-Link）
    //     用 VSCode 调试前，先在 Keil 里 Stop Debugging
    // ========================================================================
    "version": "0.2.0",
    "configurations": [
        {
            "name": "J-Link 调试（Cortex-Debug）",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",

            // 芯片型号（和 J-Scope 里填的一样）
            "device": "STM32F427II",
            "interface": "swd",

            // 要调试的固件（Keil 编译出来的 .axf）
            "executable": "${workspaceFolder}/MDK-ARM/TEST/TEST.axf",

            // 启动前先编译（对应 tasks.json 里的"① 编译"）
            "preLaunchTask": "① 编译 (Build)",

            // 停在 main 函数
            "runToEntryPoint": "main",

            // J-Link 速度（低一点更稳，尤其用杜邦线接的时候）
            "serverArgs": [
                "-speed", "1000"
            ],

            // SWO / ITM 的时钟（用不到可以不管）
            "swoConfig": {
                "enabled": false
            }
        },
        {
            "name": "J-Link 调试（不重新编译）",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "device": "STM32F427II",
            "interface": "swd",
            "executable": "${workspaceFolder}/MDK-ARM/TEST/TEST.axf",
            "runToEntryPoint": "main",
            "serverArgs": [
                "-speed", "1000"
            ]
        }
    ]
}
