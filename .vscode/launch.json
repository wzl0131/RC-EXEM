{
    // ========================================================================
    //  调试配置 —— 需要装 Cortex-Debug 插件（marus25.cortex-debug）
    //
    //  ⚠️ VSCode 调试 / Keil 调试 / J-Scope 三者【不能同时用】
    //     （都要独占 J-Link）
    //     用 VSCode 调试前，先在 Keil / J-Scope 里停掉
    //
    //  ⭐ 用的时候：左边栏【运行和调试】(Ctrl+Shift+D)
    //     → 顶部下拉框选 "J-Link 调试（先编译）"  ← 选这个！
    //     → 按 F5
    //
    //  ⚠️ 不要选 "Debug with ST-Link" —— 那个是 VSCode 自动生成的模板，
    //     指向不存在的 bin/executable.elf，会报 "Unable to find executable file"
    // ========================================================================
    "version": "0.2.0",
    "configurations": [
        {
            "name": "J-Link 调试（先编译）",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",

            // 芯片型号（和 J-Scope / Keil 里填的一致）
            "device": "STM32F427II",
            "interface": "swd",

            // 要调试的固件（Keil 编译出来的 .axf）
            "executable": "${workspaceFolder}/MDK-ARM/TEST/TEST.axf",

            // ⭐ SVD 文件 —— 有了它才能看外设寄存器（Peripherals 面板）
            "svdFile": "${workspaceFolder}/.vscode/STM32F427.svd",

            // 启动前先编译（对应 tasks.json 里的"① 编译"）
            "preLaunchTask": "① 编译 (Build)",

            // 停在 main 函数（想直接跑就把这行删掉）
            "runToEntryPoint": "main",

            // J-Link 速度（低一点更稳，尤其用杜邦线接的时候）
            "serverArgs": [
                "-speed", "1000"
            ],

            // 调试器自己的日志：none / brief / full
            // 连不上目标的时候改成 "full" 能看到详细信息
            "showDevDebugOutput": "none"
        },
        {
            "name": "J-Link 调试（不重新编译）",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "device": "STM32F427II",
            "interface": "swd",
            "executable": "${workspaceFolder}/MDK-ARM/TEST/TEST.axf",
            "svdFile": "${workspaceFolder}/.vscode/STM32F427.svd",
            "runToEntryPoint": "main",
            "serverArgs": [
                "-speed", "1000"
            ],
            "showDevDebugOutput": "none"
        },
        {
            // ================================================================
            //  ⚠️ 备用配置：如果你手上只有 ST-Link
            //
            //  用之前必须先装 ST-Link 的 GDB Server，二选一：
            //    ① STM32CubeProgrammer（里面带 ST-LINK_gdbserver.exe）
            //    ② stlink-tools（提供 st-util.exe）
            //
            //  装完把下面的 "serverpath" 指向那个 exe
            //
            //  ⚠️⚠️ 但注意：J-Scope 【不支持 ST-Link】！
            //     用 ST-Link 就录不了实时曲线，只能用 Keil 的 Watch 看数值
            // ================================================================
            "name": "ST-Link 调试（要先装 GDB Server）",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stlink",
            "device": "STM32F427II",
            "interface": "swd",
            "executable": "${workspaceFolder}/MDK-ARM/TEST/TEST.axf",
            "svdFile": "${workspaceFolder}/.vscode/STM32F427.svd",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        }
    ]
}
